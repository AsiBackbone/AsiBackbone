<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>asibackbone-samples-aspire-apphost</UserSecretsId>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">
      packages.$(RuntimeIdentifier).lock.json
    </NuGetLockFilePath>

    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == ''">
      packages.$(NETCoreSdkRuntimeIdentifier).lock.json
    </NuGetLockFilePath>

    <!-- The sample builds and runs without the Aspire CLI bundle; see ASPIRE010. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlainAspNetCoreHost\AsiBackbone.Samples.PlainAspNetCoreHost.csproj" />
  </ItemGroup>

</Project>
