<Project>
  <!--
    Apply CS1591 controls after project files load so package projects can opt
    into a scoped baseline with AsiBackboneSuppressMissingXmlDocs=true while
    inventory/enforcement commands can override that property from the CLI.
  -->
  <PropertyGroup Condition="'$(AsiBackboneSuppressMissingXmlDocs)' == 'true'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AsiBackboneEnforceMissingXmlDocs)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!--
    TreatWarningsAsErrors is enabled repository-wide. Keep CS1591 as a warning
    unless enforcement is requested so inventory mode can report documentation
    gaps without failing the build.
  -->
  <PropertyGroup Condition="'$(AsiBackboneEnforceMissingXmlDocs)' != 'true'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Validate shipped packages against the last released version so public API
    and binary-compatibility breaks fail pack instead of reaching NuGet. Bump
    AsiBackbonePackageValidationBaselineVersion after each release; disable only
    for an intentional major-version break.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <AsiBackbonePackageValidationBaselineVersion Condition="'$(AsiBackbonePackageValidationBaselineVersion)' == ''">5.1.0</AsiBackbonePackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(AsiBackbonePackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
