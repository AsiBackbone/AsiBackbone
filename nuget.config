<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- AsiBackbone packages are intentionally unsigned; SECURITY.md documents the current provenance-based trust model. -->
	<config>
		<add key="signatureValidationMode" value="accept" />
	</config>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
