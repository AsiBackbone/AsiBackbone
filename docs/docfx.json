{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "*/*.csproj"
          ],
          "exclude": [
            "AsiBackbone.Templates/**"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "api-reference.md",
          "**/toc.yml",
          "articles/**/*.md",
          "quality/**/*.md",
          "api/**/*.yml",
          "releases/**/*.md",
          "maintainers/**/*.md",
          "history/**/*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "public/**"
        ]
      }
    ],
    "dest": "_site",
    "sitemap": {
      "baseUrl": "https://asibackbone.github.io/AsiBackbone/",
      "changefreq": "weekly"
    },
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "globalMetadata": {
      "_lang": "en",
      "_appName": "AsiBackbone",
      "_appTitle": "AsiBackbone",
      "_appLogoPath": "images/asibackbone-icon-50.png",
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "<span>Part of <a href=\"https://asibackbone.github.io/\">AsiBackbone</a> · <a href=\"https://github.com/AsiBackbone/AsiBackbone\">Source</a> · <a href=\"https://github.com/orgs/AsiBackbone/discussions\">Community</a> · <a href=\"https://github.com/AsiBackbone/AsiBackbone/blob/main/LICENSE.txt\">License</a> · <a href=\"https://doi.org/10.5281/zenodo.20546032\">Archive (DOI)</a> · Made with <a href=\"https://dotnet.github.io/docfx\">DocFX</a></span>",
      "_enableSearch": true,
      "_canonicalBaseUrl": "https://asibackbone.github.io/AsiBackbone/",
      "_structuredDataSiteName": "AsiBackbone",
      "_structuredDataSiteDescription": "Documentation for AsiBackbone, a .NET governance and policy-control package family for accountable software execution.",
      "_structuredDataPublisherName": "AsiBackbone",
      "_structuredDataPublisherUrl": "https://github.com/AsiBackbone",
      "_socialImageUrl": "https://asibackbone.github.io/AsiBackbone/images/social-preview.png",
      "_socialImageType": "image/png",
      "_socialImageWidth": "640",
      "_socialImageHeight": "320",
      "_socialImageAlt": "AsiBackbone — governed decisions for .NET applications"
    }
  }
}
