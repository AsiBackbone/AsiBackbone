{
  "id": 22953496,
  "name": "Main branch security baseline",
  "target": "branch",
  "source_type": "Repository",
  "source": "AsiBackbone/AsiBackbone",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": true,
        "dismissal_restriction": {
          "enabled": true,
          "allowed_actors": [
            {
              "id": 5,
              "type": "RepositoryRole"
            }
          ]
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Dependency review",
            "integration_id": 15368
          },
          {
            "context": "Build, test, and pack",
            "integration_id": 15368
          },
          {
            "context": "Validate version consistency",
            "integration_id": 15368
          },
          {
            "context": "External consumer package smoke test",
            "integration_id": 15368
          },
          {
            "context": "Restore, build, test, docs, pack, and smoke",
            "integration_id": 15368
          },
          {
            "context": "Validate workflows with actionlint",
            "integration_id": 15368
          },
          {
            "context": "Analyze workflows with zizmor",
            "integration_id": 15368
          },
          {
            "context": "Analyze dependencies with OWASP Dependency-Check",
            "integration_id": 15368
          },
          {
            "context": "CodeQL analysis (actions, none)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL analysis (csharp, manual)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": false
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "medium_or_higher",
            "alerts_threshold": "errors_and_warnings"
          }
        ]
      }
    },
    {
      "type": "code_quality",
      "parameters": {
        "severity": "warnings"
      }
    }
  ],
  "bypass_actors": []
}