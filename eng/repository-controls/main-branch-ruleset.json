{
  "name": "Main branch security baseline",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 28095137,
      "actor_type": "User",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Dependency review",
            "integration_id": 15368
          },
          {
            "context": "Build, test, and pack",
            "integration_id": 15368
          },
          {
            "context": "CodeQL analysis",
            "integration_id": 15368
          },
          {
            "context": "Validate version consistency",
            "integration_id": 15368
          },
          {
            "context": "External consumer package smoke test",
            "integration_id": 15368
          },
          {
            "context": "Restore, build, test, docs, pack, and smoke",
            "integration_id": 15368
          }
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
