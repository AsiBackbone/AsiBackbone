<?xml version="1.0" encoding="UTF-8"?>
<suppressions
    xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd
        https://dependency-check.github.io/DependencyCheck/dependency-suppression.1.4.xsd">

    <!--
    Every entry must name a package that appears in a committed lock file, and
    every entry must expire at the end of the next quarter so the rationale is
    re-reviewed rather than inherited indefinitely.

    Package versions are deliberately not pinned. These are cross-ecosystem
    identifier collisions, so the rationale is a property of the CVE-to-package
    mapping rather than of any one version; pinning a version silently disables
    the suppression at the next dependency bump.
  -->

    <!--
    Cross-ecosystem OpenTelemetry findings applying to Go or C++
    implementations rather than the .NET NuGet packages. Both packages resolve
    transitively through the Aspire AppHost sample.
  -->

    <suppress until="2026-12-31Z">
        <notes>
            <![CDATA[
      Reviewed cross-ecosystem false positives for the .NET OTLP exporter.
    ]]>
        </notes>
        <packageUrl regex="true">^pkg:nuget/OpenTelemetry\.Exporter\.OpenTelemetryProtocol@.*$</packageUrl>
        <vulnerabilityName regex="true">^CVE-2026-(39882|39883|41178|44967)$</vulnerabilityName>
    </suppress>

    <suppress until="2026-12-31Z">
        <notes>
            <![CDATA[
      Reviewed cross-ecosystem false positives for OpenTelemetry .NET hosting.
    ]]>
        </notes>
        <packageUrl regex="true">^pkg:nuget/OpenTelemetry\.Extensions\.Hosting@.*$</packageUrl>
        <vulnerabilityName regex="true">^CVE-2026-(39882|39883|41178|44967)$</vulnerabilityName>
    </suppress>

</suppressions>
